<Window x:Class="ImagesToPdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Images to PDF" Height="820" Width="1320" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Icon="/ImagesToPdf;component/Assets/images-to-pdf.png"
        Background="{DynamicResource AppBackground}"
        AllowDrop="False" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <!-- App header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="2,0,2,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/ImagesToPdf;component/Assets/images-to-pdf.png" Width="44" Height="44"
                           Stretch="Uniform" Margin="0,0,12,0" SnapsToDevicePixels="True" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Images to PDF" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Normalize your images. Keep every page consistent." FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="App appearance" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <ComboBox x:Name="ThemeBox" Width="145" Style="{DynamicResource AppComboBoxStyle}"
                              SelectionChanged="Theme_Changed" SelectedIndex="0">
                        <ComboBoxItem Content="Follow Windows" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.02*" MinWidth="330" />
                <ColumnDefinition Width="1.22*" MinWidth="360" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- Image queue -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IMAGE QUEUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock x:Name="ImageCountText" Text="No images added" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="AddImagesBtn" Grid.Column="1" Content="＋ Add images" Style="{DynamicResource ActionButtonStyle}" Click="AddImages_Click" />
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="0,12,0,12">
                        <Button x:Name="AddFolderBtn" Content="Add folder" Style="{DynamicResource SecondaryButtonStyle}" Click="AddFolder_Click" Margin="0,0,6,0" />
                        <Button x:Name="MoveUpBtn" Content="↑" ToolTip="Move selected up" Style="{DynamicResource SecondaryButtonStyle}" Click="Up_Click" Width="38" Margin="0,0,6,0" />
                        <Button x:Name="MoveDownBtn" Content="↓" ToolTip="Move selected down" Style="{DynamicResource SecondaryButtonStyle}" Click="Down_Click" Width="38" Margin="0,0,6,0" />
                        <Button x:Name="RemoveBtn" Content="Remove" Style="{DynamicResource SecondaryButtonStyle}" Click="Remove_Click" Margin="0,0,6,0" />
                        <Button x:Name="SortBtn" Content="Sort A–Z" Style="{DynamicResource SecondaryButtonStyle}" Click="Sort_Click" Margin="0,0,6,0" />
                        <Button x:Name="ClearBtn" Content="Clear all" Style="{DynamicResource SecondaryButtonStyle}" Click="Clear_Click" />
                    </WrapPanel>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="List" AllowDrop="True" SelectionMode="Extended"
                                 Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                 Foreground="{DynamicResource TextPrimary}" HorizontalContentAlignment="Stretch"
                                 PreviewMouseLeftButtonDown="List_PreviewMouseDown"
                                 PreviewMouseMove="List_PreviewMouseMove"
                                 DragOver="List_DragOver" Drop="List_Drop" KeyDown="List_KeyDown"
                                 SelectionChanged="List_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="3" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Border}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="88">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Border Grid.Column="1" Width="72" Height="72" CornerRadius="6" Background="{DynamicResource PreviewBackground}"
                                                ClipToBounds="True" VerticalAlignment="Center">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="10,0,2,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                            <TextBlock Text="{Binding Dimensions}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding FrameLabel}" FontSize="10" Foreground="{DynamicResource Accent}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="Hint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <TextBlock Text="▧" FontSize="36" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Drop images or folders here" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="or use Add images to build your PDF" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <CheckBox x:Name="AutoSort" Content="Sort by filename when adding" IsChecked="True" Style="{DynamicResource AppCheckBoxStyle}"
                                  Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="RecursiveBox" Content="Include subfolders when adding a folder" Style="{DynamicResource AppCheckBoxStyle}"
                                  Checked="Option_Changed" Unchecked="Option_Changed" />
                        <TextBlock Text="Tip: Select multiple items to move or remove them together. Delete also removes the selection."
                                   TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Output preview -->
            <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="OUTPUT PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock x:Name="PreviewTitle" Text="Select an image to preview" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="PreviewFrame" Grid.Row="1" Background="{DynamicResource PreviewBackground}"
                            CornerRadius="9" Padding="18" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                            <TextBlock x:Name="PreviewPlaceholder" Text="Your normalized page preview will appear here"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" MaxWidth="220" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PreviewInfo" Text="The preview matches the exported page layout." FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            <TextBlock x:Name="AspectWarning" Text="" FontSize="11" Foreground="{DynamicResource Danger}"
                                       TextWrapping="Wrap" Margin="0,4,8,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <TextBlock Text="This page" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="PageFitBox" Width="145" Style="{DynamicResource AppComboBoxStyle}" Margin="0,0,10,0"
                                      SelectionChanged="PageFit_Changed">
                                <ComboBoxItem Content="Use global default" />
                                <ComboBoxItem Content="Fit this page" />
                                <ComboBoxItem Content="Crop this page" />
                            </ComboBox>
                            <TextBlock Text="Frame" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="PreviewFrameBox" Width="72" Style="{DynamicResource AppComboBoxStyle}"
                                      SelectionChanged="PreviewFrame_Changed" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Export settings -->
            <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PDF SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="Page layout" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12" />

                        <TextBlock Text="Page size" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ComboBox x:Name="PageSizeBox" Style="{DynamicResource AppComboBoxStyle}" Margin="0,5,0,0"
                                  SelectionChanged="Settings_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="Original — first image ratio" />
                            <ComboBoxItem Content="A4 Portrait" />
                            <ComboBoxItem Content="A4 Landscape" />
                            <ComboBoxItem Content="Letter Portrait" />
                            <ComboBoxItem Content="Letter Landscape" />
                            <ComboBoxItem Content="Square (8 × 8 in)" />
                            <ComboBoxItem Content="16:9 (12 × 6.75 in)" />
                            <ComboBoxItem Content="4:3 (10 × 7.5 in)" />
                        </ComboBox>
                        <TextBlock Text="Original uses the first image to set one shared page ratio. Standard sizes use fixed paper dimensions."
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,10" />

                        <TextBlock Text="How images fit" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ComboBox x:Name="FitModeBox" Style="{DynamicResource AppComboBoxStyle}" Margin="0,5,0,0"
                                  SelectionChanged="Settings_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="Fit entire image (show background)" />
                            <ComboBoxItem Content="Fill page (crop edges)" />
                        </ComboBox>
                        <TextBlock Text="Fit keeps the whole image. Fill covers the page and crops the overflow from the center. Preview each page before exporting."
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,10" />

                        <TextBlock Text="PDF theme" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ComboBox x:Name="PdfThemeBox" Style="{DynamicResource AppComboBoxStyle}" Margin="0,5,0,0"
                                  SelectionChanged="Settings_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="White" />
                            <ComboBoxItem Content="Red PDF theme" />
                            <ComboBoxItem Content="Light gray" />
                        </ComboBox>
                        <TextBlock x:Name="PdfThemeHelp" Text="The page background appears around images when Fit is selected. Red PDF theme adds a visible red page frame."
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,10" />

                        <Separator Background="{DynamicResource Border}" Margin="0,2,0,10" />
                        <TextBlock Text="Resolution &amp; quality" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

                        <TextBlock Text="Resolution strategy" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ComboBox x:Name="ResolutionBox" Style="{DynamicResource AppComboBoxStyle}" Margin="0,5,0,0"
                                  SelectionChanged="Settings_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="Highest (upscale others)" />
                            <ComboBoxItem Content="Median" />
                            <ComboBoxItem Content="Average" />
                            <ComboBoxItem Content="Lowest (downscale others)" />
                        </ComboBox>
                        <TextBlock x:Name="ResolutionHelp" Text="Every page is normalized to the same pixel dimensions."
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,10" />

                        <TextBlock Text="PDF resolution (DPI)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ComboBox x:Name="DpiBox" Style="{DynamicResource AppComboBoxStyle}" Margin="0,5,0,0"
                                  SelectionChanged="Settings_Changed" SelectedIndex="0">
                            <ComboBoxItem Content="150 DPI" Tag="150" />
                            <ComboBoxItem Content="200 DPI" Tag="200" />
                            <ComboBoxItem Content="300 DPI" Tag="300" />
                        </ComboBox>
                        <TextBlock x:Name="TargetInfo" Text="Add images to calculate the output size." FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,10" />

                        <TextBlock Text="Image processing" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        <ComboBox x:Name="QualityBox" Style="{DynamicResource AppComboBoxStyle}" Margin="0,5,0,0"
                                  SelectionChanged="Settings_Changed" SelectedIndex="1">
                            <ComboBoxItem Content="Smaller file (JPEG)" />
                            <ComboBoxItem Content="Best detail (lossless PNG)" />
                        </ComboBox>
                        <CheckBox x:Name="IncludeAllFramesBox" Content="Include every GIF/TIFF frame or page"
                                  Style="{DynamicResource AppCheckBoxStyle}" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <TextBlock Text="When disabled, only the first frame/page of each animated or multi-page image is included."
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,12" />

                        <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="OUTPUT SUMMARY" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="PageCountText" Text="0 PDF pages" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,5,0,0" />
                                <TextBlock x:Name="SummaryInfo" Text="All pages will share one aspect ratio and resolution."
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="CreateBtn" Content="Create PDF" Style="{DynamicResource ActionButtonStyle}"
                                Click="Create_Click" Margin="0,14,0,0" Padding="12,11" FontSize="14" />
                        <Button x:Name="CancelBtn" Content="Cancel export" Style="{DynamicResource SecondaryButtonStyle}"
                                Click="Cancel_Click" Margin="0,7,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="9" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Text="Ready — add images to get started." Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="100"
                             Value="0" Background="{DynamicResource SurfaceAlt}" Foreground="{DynamicResource Accent}" />
            </Grid>
        </Border>
    </Grid>
</Window>
