<Window x:Class="ImagesToPdf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Images to PDF" Height="640" Width="960" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="List" Grid.Column="0" AllowDrop="True" SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch"
                 PreviewMouseLeftButtonDown="List_PreviewMouseDown"
                 PreviewMouseMove="List_PreviewMouseMove"
                 Drop="List_Drop" KeyDown="List_KeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Index}" VerticalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                        <Image Grid.Column="1" Source="{Binding Thumb}" Width="96" Height="96" Stretch="Uniform"/>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Dims}" Foreground="Gray"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Hint" Grid.Column="0" Text="Drop images or folders here" Foreground="Gray"
                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <Button Content="Add images…" Click="AddImages_Click" Padding="6"/>
            <Button Content="Add folder…" Click="AddFolder_Click" Padding="6" Margin="0,6,0,0"/>
            <UniformGrid Columns="2" Margin="0,6,0,0">
                <Button Content="▲ Up" Click="Up_Click" Padding="6" Margin="0,0,3,0"/>
                <Button Content="▼ Down" Click="Down_Click" Padding="6" Margin="3,0,0,0"/>
            </UniformGrid>
            <Button Content="Remove selected (Del)" Click="Remove_Click" Padding="6" Margin="0,6,0,0"/>
            <Button Content="Clear all" Click="Clear_Click" Padding="6" Margin="0,6,0,0"/>
            <Button Content="Sort A→Z now" Click="Sort_Click" Padding="6" Margin="0,6,0,0"/>
            <CheckBox x:Name="AutoSort" Content="Auto-sort by name when adding" IsChecked="True" Margin="0,8,0,0"/>

            <TextBlock Text="Page resolution" FontWeight="SemiBold" Margin="0,18,0,4"/>
            <ComboBox x:Name="ResBox" SelectedIndex="0" SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="Highest (upscale others)"/>
                <ComboBoxItem Content="Medium – median"/>
                <ComboBoxItem Content="Medium – average"/>
                <ComboBoxItem Content="Lowest (downscale others)"/>
            </ComboBox>
            <TextBlock x:Name="TargetInfo" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Quality" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <ComboBox x:Name="QualityBox" SelectedIndex="0">
                <ComboBoxItem Content="Quickest"/>
                <ComboBoxItem Content="High quality"/>
            </ComboBox>

            <Button x:Name="CreateBtn" Content="Create PDF" Click="Create_Click" Padding="8" Margin="0,22,0,0" FontWeight="Bold"/>
            <ProgressBar x:Name="Progress" Height="10" Margin="0,8,0,0"/>
            <TextBlock x:Name="Status" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
